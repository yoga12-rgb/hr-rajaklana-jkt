{
  "installCommand": "npm ci",
  "buildCommand": "npm run check && npm run build",
  "outputDirectory": "build",
  "rewrites": [{ "source": "/((?!api/|_app/|icons/|icon.svg|manifest.webmanifest|service-worker.js|200.html).*)", "destination": "/200.html" }],
  "functions": { "api/biometric.mjs": { "maxDuration": 120, "includeFiles": "{node_modules/@vladmandic/face-api/model/**,node_modules/@tensorflow/tfjs-backend-wasm/dist/*.wasm,server/face-model-manifest.json}" } },
  "headers": [
    { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] }
  ]
}
