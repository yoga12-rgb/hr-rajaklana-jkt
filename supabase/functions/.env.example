APP_ORIGIN=http://localhost:5173
# Canonical app URL for THIS database environment and account invitations.
# For hosted Production or Preview, use its stable HTTPS application origin.
# Optional additional explicit origins (comma separated). This does not change
# invitation URLs. Never allow *.vercel.app or mix Production and Preview apps.
APP_ALLOWED_ORIGINS=
# For first-admin setup only. Generate >=32 random characters, remove after setup.
HR_BOOTSTRAP_SECRET=
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically to deployed Supabase Edge Functions. Never use service_role in VITE_ variables.
