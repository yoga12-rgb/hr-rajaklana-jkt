# Browser configuration: PUBLIC_* values are bundled into the SPA.
# Never put a service-role, VAPID private, or worker secret in PUBLIC_* variables.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Empty values start the clearly labelled local demonstration.
# Hosted deployments use production or preview; local development is the default.
PUBLIC_APP_ENV=development

# Server-only Vercel Node Function configuration. Leave blank for local demo.
# Provision real values using the hosting environment's secret settings; never
# commit a populated .env file. Use separate Supabase projects/VAPID keys per env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=

# Supabase push-dispatch Edge Function secrets only (not browser configuration):
# VAPID_PUBLIC_KEY=<same-environment public VAPID key>
# VAPID_PRIVATE_KEY=<same-environment private VAPID key>
# PUSH_WORKER_SECRET=<random dedicated wake credential, minimum 32 characters>
# PUSH_CONTACT=mailto:rajaklanajombang@gmail.com
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by the Edge runtime.
